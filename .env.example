# Public application URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database (use a dedicated MongoDB database; never commit real credentials)
DATABASE_URI=mongodb://localhost:27017/medtech-commerce

# Payload secret: replace with a long random secret stored only in the deployment environment
PAYLOAD_SECRET=replace-with-a-long-random-secret

# S3-compatible media storage (Cloudflare R2, AWS S3, etc.)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Stripe integration (keep credentials outside Git)
STRIPE_SECRET_KEY=

# FedaPay Mobile Money — keep sandbox until merchant activation and end-to-end verification
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
